---
/**
 * The answer block above the regional tables on every band page: what the band
 * is (from the MHCLG Table 9 ratio note held in the data), the England average
 * for that band when MHCLG publishes one, ten and twelve instalment arithmetic
 * on that average, a blank note when no average is held for the band, and the
 * GOV.UK band checker. No derived band average and no valuation ranges the
 * committed data does not hold.
 */
import Fact from "./Fact.astro";
import {
  CURRENT_YEAR,
  PREVIOUS_YEAR,
  bandMeaning,
  loadYear,
  pounds,
  percentChangeOn,
  tenInstalments,
  twelveInstalments,
  wholePounds,
  yearLabel,
  type Band,
} from "../lib/council-tax";
import { councilTaxSource, tableName } from "../lib/sources";
import { OFFICIAL_BAND_CHECK } from "../lib/site";

interface Props {
  band: Band;
}

const { band } = Astro.props;
const data = loadYear(CURRENT_YEAR);
const year = yearLabel(CURRENT_YEAR);
const previous = yearLabel(PREVIOUS_YEAR);
const area = data.england.areaBandD;
const bandSource = councilTaxSource(CURRENT_YEAR, data.source.bandTable);
const areaSource = area ? councilTaxSource(CURRENT_YEAR, area.table) : null;
const englandAverageForBand = band === "D" && area && typeof area.england.pounds === "number"
  ? area.england.pounds
  : null;
const englandChange = area ? percentChangeOn(area.england.changePct, previous) : null;
const areaTableLabel = area ? tableName(area.table) : null;
const instalmentSource = areaSource
  ? {
      ...areaSource,
      method: "Calculated from the published England average",
    }
  : null;
---
<section class="section" id="band-headline" aria-labelledby="band-headline-heading">
  <h2 id="band-headline-heading">Band {band} at a glance</h2>
  <p class="lede">{bandMeaning(band)}</p>

  {typeof englandAverageForBand === "number" && area && areaSource && instalmentSource ? (
    <div class="fact-grid">
      <div class="card">
        <Fact
          label={`England average area Band ${band}, ${year}`}
          figure={wholePounds(englandAverageForBand)}
          change={englandChange}
          source={areaSource}
        >
          <p class="caveat">Includes the adult social care and average parish precepts.</p>
        </Fact>
        <div class="instalment-row" aria-label={`Monthly equivalents of the England Band ${band} average`}>
          <Fact
            class="fact-small"
            label={`Over ten instalments, ${year}`}
            figure={pounds(tenInstalments(englandAverageForBand))}
            source={instalmentSource}
          >
            <span class="band-monthly">
              Annual charge divided by ten and rounded to pennies
            </span>
          </Fact>
          <Fact
            class="fact-small"
            label={`Over twelve instalments, ${year}`}
            figure={pounds(twelveInstalments(englandAverageForBand))}
            source={instalmentSource}
          >
            <span class="band-monthly">
              Annual charge divided by twelve and rounded to pennies
            </span>
          </Fact>
        </div>
      </div>
    </div>
  ) : (
    <p class="muted" data-band-average-absent>
      MHCLG does not publish an England average for Band {band}. The England average it publishes is for Band D only{areaTableLabel ? ` (${year}, ${areaTableLabel})` : ` (${year})`}. Band {band} for every council is listed in the tables below from {bandSource.table}.
    </p>
  )}

  <div class="action-links" aria-label="Find your property band">
    <a href={OFFICIAL_BAND_CHECK}>Find your property band on GOV.UK</a>
  </div>
</section>

<style>
  .instalment-row {
    display: grid;
    gap: 0.9rem;
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
  }
  @media (min-width: 40rem) {
    .instalment-row { grid-template-columns: 1fr 1fr; }
  }
  .band-monthly { display: block; color: var(--text-muted); margin-top: 0.35rem; }
  .card :global(.fact-small .fact-figure) { font-size: 1.3rem; }
</style>
