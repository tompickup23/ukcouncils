---
/**
 * The footer. It names no person and takes no position: the imprint is the
 * site's own name and what it does.
 */
import { SITE_NAME } from "../lib/site";


import { networkFooter } from "../lib/network-footer";
const network = await networkFooter;
const year = new Date().getUTCFullYear();
---
<footer class="site-footer">
  <div class="shell">
    {network && <p>Part of the UK State public data network. <a href={network.method}>Method</a> · <a href={network.corrections}>Network corrections</a></p>}
    <p class="footer-imprint">
      An independent reference site, not a council or government service.
      {SITE_NAME} republishes official figures about local authorities in the UK. Every figure carries its
      source and date. Council tax figures are from the Ministry of Housing, Communities and Local
      Government under the Open Government Licence v3.0. &copy; {year} {SITE_NAME}.
    </p>
    <p class="footer-links"><a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/corrections/">Corrections</a> · <a href="/privacy/">Privacy</a></p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    background: var(--ground);
    color: var(--ground-muted);
    padding: 2rem 0 2.5rem;
    font-size: 0.92rem;
  }
  .footer-imprint { max-width: 48rem; margin: 0; line-height: 1.5; }
  .footer-links a { color: var(--ground-ink); }
</style>
