---
/**
 * The next school break from the UK School Holiday Dates snapshot, for the
 * education authority the snapshot joins the council to by GSS code. Renders
 * nothing where the snapshot holds no calendar. The selection is made in
 * src/lib/council-profile.ts.
 */
import { longDate } from "../lib/sources";
import type { ProfileTermDates } from "../lib/council-profile";

interface Props {
  name: string;
  term: ProfileTermDates | null;
}

const { name, term } = Astro.props;
---
{term && <section class="section place-section" id="school-holidays" aria-labelledby="school-holidays-heading" data-profile-section="school-holidays">
<h2 id="school-holidays-heading">School holidays in {name}</h2>
{term.next
  ? <p data-next-break><strong>{term.next.label}: {longDate(term.next.start)} to {longDate(term.next.end)}</strong>, from {term.authorityName}'s {term.academicYear} reference calendar.</p>
  : <p>View the recorded {term.academicYear} calendar for {term.authorityName}.</p>}
<p class="source-line">Source: <a href={term.sourceUrl}>{term.authorityName}'s official calendar</a>{term.retrievedAt ? `, captured ${longDate(term.retrievedAt)}` : ""}. Next break selected on {longDate(term.selectedOn)}.</p>
<p>This is an education authority reference. Individual schools, local clusters and INSET days can differ. Confirm with the school before booking.</p>
<p><a href={term.authorityUrl}>Full calendar, source notes and downloads on UK School Holiday Dates</a>.</p>
</section>}
