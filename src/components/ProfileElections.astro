---
import { electionFor, electionQuoteIsHeld, electionSource } from "../lib/elections";
import SourceLine from "./SourceLine.astro";
import { sisterLinks, type Council } from "../lib/registry";
interface Props { council: Council; name: string }
const {council, name} = Astro.props;
const record = electionFor(council.gss);
const source = record ? electionSource(record) : null;
const link = sisterLinks(council).find(link => link.site === "ukelections");
const pattern = {
  whole: "The whole council is elected together.",
  thirds: "Councillors are elected by thirds.",
  halves: "Councillors are elected by halves.",
};
---
{record && source && <section class="section" id="elections" data-profile-section="elections" aria-labelledby="elections-heading">
  <h2 id="elections-heading">Elections in {name}</h2>
  <p>The next scheduled election to {name} council is in {record.dateLabel ?? record.nextYear}.</p>
  <SourceLine source={source} />
  <details data-elections-drawer><summary>Read the election schedule notes for {name}</summary>
  <p>{pattern[record.pattern]}</p>
  {!electionQuoteIsHeld(record.quote) && <blockquote cite={record.sourceUrl}>{record.quote}</blockquote>}
  <p class="caveat">A scheduled date can be moved by statutory instrument.</p>
  {link && <p><a href={link.url}>Results and seats on UK Elections</a>.</p>}
  </details>
</section>}
