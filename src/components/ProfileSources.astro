---
/**
 * One list of every table and file the council page drew on. Each entry is
 * the same source a figure on the page cites under it.
 */
import { citationKey } from "../lib/citation-key";
import { longDate } from "../lib/sources";
import type { SourceRef } from "../lib/sources";

interface Props {
  name: string;
  sources: SourceRef[];
}

const { name, sources } = Astro.props;
---
<section class="section" id="sources" aria-labelledby="sources-heading" data-profile-section="sources">
  <h2 id="sources-heading">Sources for this page on {name}</h2>
  <p class="muted">Every table and file a figure on this page cites, {sources.length} in all. Each figure also carries its own source line.</p>
  <details data-sources-drawer><summary>Read the {sources.length} sources for {name}</summary>
  <ul class="profile-sources" data-profile-sources>
    {sources.map((source) => {
      const date = longDate(source.date);
      return (
        <li data-citation-entry={citationKey(source)}>
          <a href={source.url}>{source.publisher}, {source.title}</a>{source.table ? `, ${source.table}` : ""}{date ? `, ${date}` : ""}.
        </li>
      );
    })}
  </ul>
  </details>
</section>

<script>
  // A repeated source line links to its full entry inside the closed drawer.
  // Not every browser opens a closed details element for a link into it, so open it here.
  const drawer = document.querySelector<HTMLDetailsElement>("[data-sources-drawer]");
  function reveal(hash: string) {
    if (!drawer || !hash.startsWith("#citation-")) return;
    const entry = document.getElementById(hash.slice(1));
    if (!entry || !drawer.contains(entry)) return;
    drawer.open = true;
    entry.scrollIntoView();
  }
  if (drawer) {
    document.addEventListener("click", (event) => {
      const link = (event.target as Element | null)?.closest?.('a[href^="#citation-"]');
      if (link) reveal(link.getAttribute("href")!);
    });
    window.addEventListener("hashchange", () => reveal(location.hash));
    reveal(location.hash);
  }
</script>

<style>
  .profile-sources { padding-left: 1.1rem; font-size: 0.9rem; overflow-wrap: anywhere; }
  .profile-sources li { margin: 0.3rem 0; }
</style>
