---
import BudgetTables from './BudgetTables.astro';
import SourceLine from './SourceLine.astro';
import {budgetSource, budgetYear} from '../lib/budget';
import {budgetHeadline} from '../lib/budget-headline';
import type {CouncilBudget} from '../lib/council-budget';
interface Props {view: CouncilBudget; gss: string}
const {view, gss} = Astro.props;
const headline = budgetHeadline(gss);
---
<section class="section" id="budget" data-profile-section="budget" aria-labelledby="budget-heading">
  <h2 id="budget-heading">{view.name} council budget for {budgetYear}</h2>
  {headline && <div data-fact data-budget-headline>
    <p>{headline.label}: <strong data-figure>{headline.value}</strong>.</p>
    <SourceLine source={headline.source} />
    <p class="caveat">{headline.caveat}</p>
  </div>}
  <p>This is the budget returned to MHCLG; the spending record covers published payments.</p>
  <SourceLine source={budgetSource()} />
  <details data-budget-drawer><summary>Read the service expenditure, funding and reserves tables for {view.name}</summary>
  <p>Service expenditure is net of sales, fees, charges and transfers, excluding NHS-funded expenditure. Pounds are converted from printed whole thousands.</p>
  <BudgetTables council={view.council} name={view.name} id="billing-budget" />
  </details>
  {view.county && <section id="county-budget" aria-labelledby="county-budget-heading">
    <h3 id="county-budget-heading">{view.county.name} County Council budget for {budgetYear}</h3>
    <p>The following tables cover the whole county council budget.</p>
    <details data-county-budget-drawer><summary>Read the service expenditure, funding and reserves tables for {view.county.name} County Council</summary>
    <BudgetTables council={view.county.council} name={view.county.name} id="county-budget-tables" headingLevel={4} />
    </details>
  </section>}
  {view.gameUrl && <p><a href={view.gameUrl}>Play the budget game for {view.name} on UK Council Tax</a></p>}
</section>
