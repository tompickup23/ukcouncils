---
/**
 * The summary row: what the page holds about this council, at a glance, Band D
 * first (the first screen rule) until the canonicals reverse. Each tile is a
 * digest of a section further down: it repeats one published value, carries a
 * processed source line, and links to the section, where the citation sits
 * under the same value. A fact the data does not hold has no tile.
 */
import { CURRENT_YEAR, pounds, yearLabel, type Authority } from "../lib/council-tax";
import { councilTaxSource } from "../lib/sources";
import { type SourceRef } from "../lib/sources";
import { loadYear } from "../lib/council-tax";
import { populationFor, populationSource } from "../lib/population";
import { collectionFor, collectionRate, collectionSource, collectionYear } from "../lib/collection";
import { electionFor, electionSourceLine } from "../lib/elections";
import { councilEfs } from "../lib/council-efs";
import SourceLine from "./SourceLine.astro";
import { budgetHeadline } from "../lib/budget-headline";
import type { Council } from "../lib/registry";

interface Props {
  council: Council;
  tax: Authority;
}

const { council, tax } = Astro.props;
const year = yearLabel(CURRENT_YEAR);
const whole = new Intl.NumberFormat("en-GB");

interface Tile { label: string; value: string; figure: boolean; href: string; more: string; source: SourceRef | null; caveat?: string }
const tiles: Tile[] = [];

tiles.push({
  label: `Band D, ${year}`,
  value: pounds(tax.bands.D),
  figure: true,
  href: "#council-tax",
  more: "Every band",
  source: councilTaxSource(CURRENT_YEAR, loadYear(CURRENT_YEAR).source.bandTable),
  caveat: "Area average including parish precepts.",
});

const residents = populationFor(council.gss);
if (residents !== null) tiles.push({ label: "Residents, mid-2025", value: whole.format(residents), figure: true, href: "#about", more: "About the council", source: populationSource() });

const collected = collectionFor(council.gss);
if (collected && collected.rate !== null) tiles.push({ label: `Council tax collected in year, ${collectionYear()}`, value: collectionRate(collected.rate), figure: true, href: "#collection", more: "Collection and arrears", source: collectionSource() });

const election = electionFor(council.gss);
if (election) tiles.push({ label: "Next scheduled election", value: String(election.dateLabel ?? election.nextYear), figure: true, href: "#elections", more: "Elections", source: { publisher: "UK Elections", title: election.sourceLabel, table: electionSourceLine(election).attribution, url: election.sourceUrl } });

const headline = budgetHeadline(council.gss);
if (headline) tiles.push({ label: headline.label, value: headline.value, figure: true, href: "#budget", more: "Budget and reserves", source: headline.source, caveat: headline.caveat });

if (councilEfs(council.slug)) tiles.push({ label: "Exceptional Financial Support", value: "On MHCLG's published list", figure: false, href: "#exceptional-financial-support", more: "The published entries", source: null });
---
<section class="profile-summary" aria-label={`${tax.name} at a glance`} data-profile-summary>
  <ul>
    {tiles.map((tile) => (
      <li class="summary-tile" data-fact={tile.figure ? "" : undefined} data-summary-tile={tile.href.slice(1)}>
        <span class="summary-label">{tile.label}</span>{" "}
        {tile.figure
          ? <span class="summary-value" data-figure>{tile.value}</span>
          : <span class="summary-value summary-text">{tile.value}</span>}
        {" "}
        {tile.source && <SourceLine source={tile.source} />}
        {tile.caveat && <p class="caveat">{tile.caveat}</p>}
        <p class="summary-more"><a href={tile.href}>{tile.more}</a></p>
      </li>
    ))}
  </ul>
</section>

<style>
  .profile-summary { margin: 1rem 0 0.5rem; }
  .profile-summary ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
  }
  @media (min-width: 720px) { .profile-summary ul { grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); } }
  @media (min-width: 1100px) { .profile-summary ul { grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr)); } }
  .summary-tile {
    border: 1px solid var(--border);
    border-radius: var(--radius, 8px);
    background: var(--bg-card);
    padding: 0.7rem 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .summary-label { color: var(--text-muted); font-size: 0.85rem; line-height: 1.25; }
  .summary-value { font-family: var(--font-display); font-size: 1.45rem; font-weight: 600; line-height: 1.15; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .summary-tile[data-summary-tile="budget"] .summary-value { font-size: 1.1rem; white-space: nowrap; }
  .summary-text { font-size: 1.05rem; }
  .summary-tile :global(.source-line), .summary-tile .caveat, .summary-more { margin: 0; font-size: 0.78rem; line-height: 1.3; overflow-wrap: anywhere; }
  .summary-tile :global(.source-line) { padding-top: 0.25rem; }
  .summary-more { margin-top: auto; padding-top: 0.3rem; font-size: 0.85rem; }
</style>
