---
/**
 * One year's section of the increases page: how much each council raised its
 * own share of Band D that year, as MHCLG publishes it, largest first within
 * each class of authority. The referendum limit is quoted from MHCLG's own
 * definition and stated as the rule; no sentence says why any council set what
 * it set. A table the year's file does not hold is absent, not blank.
 */
import Fact from "./Fact.astro";
import SourceLine from "./SourceLine.astro";
import {
  CURRENT_YEAR,
  loadYear,
  percent,
  pounds,
  precedingYear,
  wholePounds,
  yearAnchor,
  yearLabel,
  type OwnFigures,
  type Year,
} from "../lib/council-tax";
import { councilPages, councilPath } from "../lib/paths";
import { councilTaxSource } from "../lib/sources";

interface Props {
  year: Year;
}

const { year: yearCode } = Astro.props;
const data = loadYear(yearCode);
const year = yearLabel(yearCode);
const previous = yearLabel(precedingYear(yearCode));
const isCurrent = yearCode === CURRENT_YEAR;
const id = (part: string) => `${yearCode}-${part}`;
const area = data.england.areaBandD;
const classes = data.england.byClass;
const principles = data.source.referendumPrinciples;
const tables = data.source.ownTables;

// A council links to its page only where this year's ONS code is the code the
// page is built from: a reissued code marks a boundary change.
const pageByCode = new Map(councilPages().map((p) => [p.council.gss, councilPath(p.council)]));

interface Row {
  name: string;
  href: string | null;
  own: OwnFigures;
}

const sortRows = (rows: Row[]) =>
  rows
    .filter((r) => typeof r.own.changePct === "number")
    .sort((a, b) => (b.own.changePct as number) - (a.own.changePct as number) || a.name.localeCompare(b.name));

// Every authority in the year's table appears, linked or not.
const authorities = Object.entries(data.authorities);
const rowsFor = (district: boolean) =>
  sortRows(
    authorities
      .filter(([, a]) => a.own && (a.classCode === "SD") === district)
      .map(([code, a]) => ({ name: a.name, href: pageByCode.get(code) ?? null, own: a.own as OwnFigures })),
  );
const unitaryRows = rowsFor(false);
const districtRows = rowsFor(true);
const countyRows = sortRows(Object.values(data.counties).map((own) => ({ name: `${own.name} County Council`, href: null, own })));

const groups = [
  {
    id: "unitary",
    label: "London boroughs, metropolitan districts and unitary authorities",
    question: "How much did London boroughs, metropolitan districts and unitary authorities raise their share?",
    table: tables.unitary,
    rows: unitaryRows,
    pounds: false,
  },
  {
    id: "county",
    label: "Shire county councils",
    question: "How much did county councils raise their share?",
    table: tables.county,
    rows: countyRows,
    pounds: false,
  },
  {
    id: "district",
    label: "Shire district councils",
    question: "How much did district councils raise their share?",
    table: tables.district,
    rows: districtRows,
    pounds: true,
  },
].filter((group) => group.table && group.rows.length > 0);
---
<section class="section year-section" id={yearAnchor(yearCode)} aria-labelledby={id("heading")}>
  <h2 id={id("heading")}>Council tax rises {year}</h2>

  {area && (
    <section class="section" aria-labelledby={id("england-heading")}>
      <h3 id={id("england-heading")}>{isCurrent ? "How much has council tax gone up in England this year?" : `How much did council tax go up in England in ${year}?`}</h3>
      <div class="fact-grid">
        <div class="card">
          <Fact
            label={`Average area Band D, England, ${year}`}
            figure={`up ${percent(area.england.changePct)}`}
            change={`${wholePounds(area.england.pounds)} a year`}
            source={councilTaxSource(yearCode, area.table)}
          />
        </div>
      </div>
      {classes && (
        <div class="fact" data-fact>
          <div class="table-wrap">
            <table class="data">
              <caption>Average Band D by class of authority, {year}, excluding parish precepts</caption>
              <thead><tr><th scope="col">Class</th><th scope="col" class="num">Band D</th><th scope="col" class="num">Change on {previous}</th></tr></thead>
              <tbody>
                {classes.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.class}</th>
                    <td class="num" data-figure>{wholePounds(row.bandD)}</td>
                    <td class="num">{percent(row.changePct)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <SourceLine source={councilTaxSource(yearCode, classes.table)} />
        </div>
      )}
    </section>
  )}

  {principles && (
    <section class="section" aria-labelledby={id("limit-heading")}>
      <h3 id={id("limit-heading")}>{isCurrent ? "How much can a council raise council tax without a referendum?" : `How much could a council raise council tax without a referendum in ${year}?`}</h3>
      <p>
        A council that sets an increase in its own share above the limit for the year must hold a local
        referendum. The principles for {year}, as MHCLG's technical notes set them out, are quoted below.
        Rows for councils with a different limit carry MHCLG's note saying so.
      </p>
      <blockquote class="card">
        <p>{principles.text}</p>
        <SourceLine
          source={{
            publisher: "MHCLG",
            title: principles.title,
            url: principles.url,
            table: `section ${principles.section}`,
            date: data.source.published,
          }}
        />
      </blockquote>
    </section>
  )}

  {groups.map((group) => (
    <section class="section" id={id(group.id)} aria-labelledby={id(`${group.id}-heading`)}>
      <h3 id={id(`${group.id}-heading`)}>{isCurrent ? group.question : group.question.replace(/\?$/, ` in ${year}?`)}</h3>
      <p class="muted">Largest first. The council's own Band D excludes parish precepts and the other bodies' shares.</p>
      <div class="fact" data-fact>
        <div class="table-wrap">
          <table class="data">
            <caption>{group.label}, own Band D {year}, change on {previous}, largest first</caption>
            <thead>
              <tr>
                <th scope="col">Council</th>
                <th scope="col" class="num">Own Band D</th>
                <th scope="col" class="num">Change</th>
                {group.pounds && <th scope="col" class="num">In pounds</th>}
                <th scope="col">Note</th>
              </tr>
            </thead>
            <tbody>
              {group.rows.map((row) => (
                <tr>
                  <th scope="row">{row.href ? <a href={row.href}>{row.name}</a> : row.name}</th>
                  <td class="num">{pounds(row.own.bandD)}</td>
                  <td class="num" data-figure>{percent(row.own.changePct, 2)}</td>
                  {group.pounds && <td class="num">{pounds(row.own.changePounds)}</td>}
                  <td class="note-cell">{row.own.notes.map((n) => n.text).join(" ")}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <SourceLine source={councilTaxSource(yearCode, group.table)} />
      </div>
    </section>
  ))}
</section>

<style>
  .note-cell { font-size: 0.82rem; color: var(--text-muted); min-width: 14rem; }
  blockquote.card { margin: 1rem 0 0; }
</style>
