---
/**
 * Band D among councils of the same type: the position strip and links to every
 * band. The figure and its change on last year sit once in the band answer above
 * and once in the summary row; they are not repeated here (D1, 10 November 2026).
 */
import PositionStrip from "./PositionStrip.astro";
import { CURRENT_YEAR, pounds, yearLabel } from "../lib/council-tax";
import { regionPath } from "../lib/paths";
import type { ProfileTax } from "../lib/council-profile";

interface Props {
  name: string;
  region: string;
  tax: ProfileTax;
}

const { name, region, tax } = Astro.props;
const year = yearLabel(CURRENT_YEAR);
---
<section class="section" id="tax-summary" aria-labelledby="tax-summary-heading" data-profile-section="tax-summary">
  <h2 id="tax-summary-heading">Band D in {name} among councils of its type</h2>
  <PositionStrip id="band-d-position" kind="band-d" points={tax.points} currentGss={tax.currentGss}
    format={pounds} title={`Band D in ${name} among ${tax.classLabel}`} classLabel={tax.classLabel}
    basis={`Area Band D, ${year}, including average parish precepts`} source={tax.source}
    caveat="Area average including parish precepts. A home in a parish with its own precept pays a different amount." />
  <p class="muted">
    <a href="#council-tax">Every band from A to H in {name}</a>.
    <a href={regionPath(region)}>Band D for every council in {region}</a>.
  </p>
</section>
