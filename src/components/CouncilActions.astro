---
import {CURRENT_YEAR} from '../lib/council-tax';
interface Props {slug: string; name: string; taxLink: string | null; payLink?: string}
const {slug, name, taxLink, payLink} = Astro.props;
---
<nav class="action-links" aria-label="Council next steps" data-council-actions>
  <a class="button" data-council-compare href={`/compare/?a=${slug}&band=D&year=${CURRENT_YEAR}`}>Compare this council</a>
  {taxLink && <a href={taxLink}>{name}'s bill on UK Council Tax</a>}
  {payLink && <a href={payLink}>Pay council tax to {name}</a>}
</nav>

<style>
  @media print { [data-council-actions] { display: none; } }
</style>
