---
/**
 * One page per council: the council tax answer, then the profile built from
 * committed data in src/lib/council-profile.ts (what the council is, its
 * spending record, Band D among councils of its type, the next school break, and one list of
 * sources). A section whose data is missing is absent, not blank. Seats,
 * control and last election dates remain held.
 */
import ReorganisationPanel from "../../components/ReorganisationPanel.astro";
import {reorganisationFor} from "../../lib/reorganisation";
import SchoolHolidays from "../../components/SchoolHolidays.astro";
import CouncilActions from "../../components/CouncilActions.astro";
import MiniMap from "../../components/MiniMap.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BandSelector from "../../components/BandSelector.astro";
import PageContents from "../../components/PageContents.astro";
import HistoryBars from "../../components/HistoryBars.astro";
import Fact from "../../components/Fact.astro";
import SourceLine from "../../components/SourceLine.astro";
import SpendingRecord from "../../components/SpendingRecord.astro";
import CouncilEfs from "../../components/CouncilEfs.astro";
import { councilEfs } from "../../lib/council-efs";
import ProfileCollection from "../../components/ProfileCollection.astro";
import ProfileElections from "../../components/ProfileElections.astro";
import { collectionFor } from "../../lib/collection";
import { electionFor } from "../../lib/elections";
import ProfileBudget from "../../components/ProfileBudget.astro";
import ProfileAbout from "../../components/ProfileAbout.astro";
import ProfileTax from "../../components/ProfileTax.astro";
import ProfileSources from "../../components/ProfileSources.astro";
import ProfileSummary from "../../components/ProfileSummary.astro";
import {
  AREA_TYPE_LABEL,
  CURRENT_YEAR,
  PREVIOUS_YEAR,
  YEARS,
  areaTypeFor,
  bandChange,
  changePhrase,
  loadYear,
  percent,
  pounds,
  wholePounds,
  yearLabel,
  type Authority,
} from "../../lib/council-tax";
import { councilPages, councilPath, regionPath } from "../../lib/paths";
import { bandLinks, similarCouncils } from "../../lib/council-links";
import { sisterLinks, type Council } from "../../lib/registry";
import { INCREASES_PATH, OFFICIAL_BAND_CHECK, OFFICIAL_COUNCIL_LOOKUP } from "../../lib/site";
import { councilCardPath } from "../../lib/og";
import { councilTaxSource } from "../../lib/sources";
import { councilTaxLink } from "../../lib/council-tax-links";
import { councilProfile } from "../../lib/council-profile";

export function getStaticPaths() {
  return councilPages().map(({ council, tax }) => ({
    params: { slug: council.slug },
    props: { council, tax },
  }));
}

interface Props {
  council: Council;
  tax: Authority;
}

const { council, tax } = Astro.props;
const current = loadYear(CURRENT_YEAR);
const name = tax.name;
const year = yearLabel(CURRENT_YEAR);
const previous = yearLabel(PREVIOUS_YEAR);
const bandD = tax.bands.D;
const changeD = bandChange(council.gss, "D");
const areaType = areaTypeFor(tax.classCode);
const englandArea = current.england.areaBandD;
const areaSource = englandArea ? councilTaxSource(CURRENT_YEAR, englandArea.table) : null;

/** The class of authority as a sentence, with the county for a district. */
const county = tax.classCode === "SD" && council.parentGss ? current.counties[council.parentGss] ?? null : null;
const TYPE_LINE: Record<Authority["classCode"], string> = {
  ILB: "An inner London borough",
  OLB: "An outer London borough",
  MD: "A metropolitan district",
  UA: "A unitary authority",
  SD: "A shire district",
};
const typeLine = county
  ? `${TYPE_LINE[tax.classCode]} in ${county.name}. ${county.name} County Council also sets council tax here.`
  : `${TYPE_LINE[tax.classCode]} in ${tax.region}.`;

/** The own share tables: the council's, and the county's for a district. */
const own = tax.own;
const ownSource = own ? councilTaxSource(CURRENT_YEAR, own.table) : null;
const countySource = county ? councilTaxSource(CURRENT_YEAR, county.table) : null;

/** Band D as published in each year held, for the short history. */
const history = YEARS.map((y) => {
  const data = loadYear(y);
  const row = data.authorities[council.gss];
  return row ? { year: y, bandD: row.bands.D, table: data.source.bandTable } : null;
}).filter((row): row is { year: (typeof YEARS)[number]; bandD: number; table: string } => row !== null);

const historySource = {
  ...councilTaxSource(CURRENT_YEAR, current.source.bandTable),
  table: `${current.source.bandTable.replace("_", " ")} each year, linked in the table`,
};
const links = sisterLinks(council);
const path = councilPath(council);
const question = `How much is council tax in ${name} in ${year}?`;
const bands = bandLinks(council, tax.region);
const similar = similarCouncils(council);
const profile = councilProfile(council, tax);
const taxLink = councilTaxLink(council.slug);

/** The title's subject, before the pipe. The H1 prints the same words. */
const title = `${name} council tax bands ${year}`;
const description = `Band D in ${name} is ${pounds(bandD)} a year in ${year}`
  + (changeD ? `, ${changePhrase(changeD)} on ${previous}` : "")
  + `. Every band from A to H, who sets each share and the England average, from MHCLG.`;
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  about={{"@type": "GovernmentOrganization", name: council.officialName, identifier: council.gss, areaServed: {"@type": "AdministrativeArea", name, identifier: council.gss}}}
  ogImage={councilCardPath(council.slug)}
  ogImageAlt={`${name}: council tax bands A to H, ${year}`}
>
  <Breadcrumbs items={[{ label: "Councils", href: "/councils/" }, { label: name }]} />

  <header class="page-head council-head">
    <p class="eyebrow">Council</p>
    <h1>{title}</h1>
    <p class="muted">{typeLine}</p>
  </header>

  <ProfileSummary council={council} tax={tax} />

  <div class="council-answer">
  <section class="section" id="council-tax" aria-labelledby="council-tax-heading">
    <h2 id="council-tax-heading">{question}</h2>
    <p class="muted">
      Choose your band for the published yearly charge, before discounts.
    </p>
    <BandSelector ons={council.gss} authority={tax} />
    {taxLink && <p>Every band, the twelve month figure and what makes up the bill: <a href={taxLink}>{name} on UK Council Tax</a>.</p>}
    <p class="small muted">Monthly equivalents divide the annual charge by ten and round to pennies. Actual bill instalments can differ.</p>
    <p class="caveat">
      Every band includes the share of every body that sets council tax here, such as the police and,
      where they exist, the county council, the fire authority and parish councils, with parish precepts as
      an average. A home in a parish with
      its own precept pays a different amount, and discounts such as the single person discount are not
      taken off.
    </p>
    {tax.notes.length > 0 && (
      <ul class="notes">
        {tax.notes.map((note) => <li>MHCLG note: {note.text}</li>)}
      </ul>
    )}
  </section>

  <MiniMap gss={council.gss} name={name} />
  </div>
  <ProfileAbout name={name} about={profile.about} />
  <div class="action-links" aria-label="Council tax next steps">
    <a class="button" data-council-compare href={`/compare/?a=${council.slug}&band=D&year=${CURRENT_YEAR}`}>Compare this council</a>
    <a href={OFFICIAL_BAND_CHECK}>Find your property band on GOV.UK</a>
    <a href={OFFICIAL_COUNCIL_LOOKUP}>Find your council for your exact bill</a>
  </div>
  <CouncilActions slug={council.slug} />
  {bands.length > 0 && (
    <nav class="band-links" aria-labelledby="band-links-heading">
      <h2 id="band-links-heading" class="small-heading">Bands A to H for every council, with {name} in its region</h2>
      <ul class="pill-nav">
        {bands.map(({ band, href }) => <li><a href={href} data-band-link={band}>Band {band}</a></li>)}
      </ul>
    </nav>
  )}
  <PageContents items={[
    {id: 'about', label: 'What the council is'},
    ...(profile.tax ? [{id: 'tax-summary', label: 'Band D among similar councils'}] : []),
    ...(collectionFor(council.gss) ? [{id: 'collection', label: 'Council tax collection'}] : []),
    ...(councilEfs(council.slug) ? [{id: 'exceptional-financial-support', label: 'Exceptional Financial Support'}] : []),
    ...(electionFor(council.gss) ? [{id: 'elections', label: 'Elections'}] : []),
    ...(reorganisationFor(council.gss) ? [{id: 'reorganisation', label: 'Local government reorganisation'}] : []),
    ...(profile.budget ? [{id: 'budget', label: 'Council budget'}] : []),
    ...(profile.budget?.county ? [{id: 'county-budget', label: 'County budget'}] : []),
    ...(profile.spending ? [{id: 'spending', label: 'Spending'}] : []),
    ...(profile.termDates ? [{id: 'school-holidays', label: 'School holidays'}] : []),
    ...(englandArea ? [{id: 'compared', label: 'England and area averages'}] : []),
    ...(history.length > 1 ? [{id: 'history', label: 'Previous years'}] : []),
    ...(own ? [{id: 'who-sets-it', label: 'Who sets the charge'}] : []),
    ...(profile.sources.length > 0 ? [{id: 'sources', label: 'Sources'}] : []),
  ]} />

  {profile.tax && <ProfileTax name={name} region={tax.region} tax={profile.tax} />}

  <ProfileCollection gss={council.gss} name={name} />
  <CouncilEfs slug={council.slug} />
  <ProfileElections council={council} name={name} />
  <ReorganisationPanel gss={council.gss} />
  {profile.budget && <ProfileBudget view={profile.budget} />}
  <SpendingRecord gss={council.gss} name={name} />

  <SchoolHolidays name={name} term={profile.termDates} />

  {englandArea && areaSource && (
    <section class="section" id="compared" aria-labelledby="compared-heading">
      <h2 id="compared-heading">How does Band D in {name} compare?</h2>
      <div class="fact-grid">
        <div class="card">
          <Fact
            label={`England average area Band D, ${year}`}
            figure={wholePounds(englandArea.england.pounds)}
            change={`up ${percent(englandArea.england.changePct)} on ${previous}`}
            source={areaSource}
          />
          <p class="caveat">Includes parish and adult social care precepts.</p>
        </div>
        <div class="card">
          <Fact
            label={`Average area Band D for ${AREA_TYPE_LABEL[areaType]}, ${year}`}
            figure={wholePounds(englandArea.byAreaType[areaType].pounds)}
            change={`up ${percent(englandArea.byAreaType[areaType].changePct)} on ${previous}`}
            source={areaSource}
          />
          <p class="caveat">Includes parish and adult social care precepts.</p>
        </div>
      </div>
      <p class="muted">
        Both averages include parish and adult social care precepts, the same basis as the {name} figure.
        <a href={regionPath(tax.region)}>Band D for every council in {tax.region}</a>.
      </p>
    </section>
  )}

  {history.length > 1 && (
    <section class="section" id="history" aria-labelledby="history-heading">
      <h2 id="history-heading">How has Band D in {name} changed?</h2>
      <div class="fact" data-fact>
        <HistoryBars rows={history.map(row => ({label: yearLabel(row.year), value: row.bandD}))} format={pounds} caption={`Published area Band D in ${name} by year`} />
        <SourceLine source={historySource} />
        <p class="caveat">Cash figures, not adjusted for inflation. Includes average parish precepts.</p>
        <div class="table-wrap" tabindex="0" role="region" aria-label="Council tax history table">
          <table class="data">
            <caption>Area Band D in {name}, as published each year</caption>
            <thead>
              <tr><th scope="col">Year</th><th scope="col" class="num">Band D</th><th scope="col">Source</th></tr>
            </thead>
            <tbody>
              {history.map((row) => (
                <tr>
                  <th scope="row">{yearLabel(row.year)}</th>
                  <td class="num" data-figure>{pounds(row.bandD)}</td>
                  <td><a href={loadYear(row.year).source.url}>MHCLG {row.table.replace("_", " ")}</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <SourceLine source={historySource} />
      </div>
    </section>
  )}

  {own && ownSource && (
    <section class="section" id="who-sets-it" aria-labelledby="who-sets-heading">
      <h2 id="who-sets-heading">Who sets council tax in {name}?</h2>
      <p class="muted">
        The Band D bill is made up of shares set by different bodies. MHCLG publishes each body's own
        average Band D; the police, fire and parish shares are published by precepting body, not by
        billing area, so they are not listed here.
      </p>
      <div class="fact-grid">
        {typeof own.bandD === "number" && (
          <div class="card">
            <Fact
              label={`${name} council's own Band D, ${year}`}
              figure={pounds(own.bandD)}
              change={typeof own.changePct === "number" ? `${own.changePct >= 0 ? "up" : "down"} ${percent(Math.abs(own.changePct), 2)} on ${previous}, as published` : null}
              source={ownSource}
            />
            <p class="caveat">The council's own share, excluding parish precepts, as MHCLG publishes it.</p>
          </div>
        )}
        {county && countySource && typeof county.bandD === "number" && (
          <div class="card">
            <Fact
              label={`${county.name} County Council's Band D, ${year}`}
              figure={pounds(county.bandD)}
              change={typeof county.changePct === "number" ? `${county.changePct >= 0 ? "up" : "down"} ${percent(Math.abs(county.changePct), 2)} on ${previous}, as published` : null}
              source={countySource}
            />
            <p class="caveat">The county council's own share, excluding parish precepts, as MHCLG publishes it.</p>
          </div>
        )}
      </div>
      {own.notes.length > 0 && (
        <ul class="notes">
          {own.notes.map((note) => <li>MHCLG note: {note.text}</li>)}
        </ul>
      )}
      <p class="muted"><a href={INCREASES_PATH}>How much every council raised its own share this year</a>.</p>
    </section>
  )}

  {/* The reorganisation field is held: see "Held data" in CLAUDE.md. */}

  {profile.sources.length > 0 && <ProfileSources name={name} sources={profile.sources} />}

  {similar && (
    <section class="section" id="similar" aria-labelledby="similar-heading">
      <h2 id="similar-heading">Similar councils</h2>
      <p class="muted">{similar.heading}, by council type in the UK Places register.</p>
      <ul class="sister-links" data-similar-councils>
        {similar.pages.map(({ council: other, tax: otherTax }) => (
          <li><a href={councilPath(other)}>{otherTax.name}</a></li>
        ))}
      </ul>
    </section>
  )}

  {links.length > 0 && (
    <section class="section" id="more" aria-labelledby="more-heading">
      <h2 id="more-heading">More on {name}</h2>
      <ul class="sister-links">
        {links.map((link) => (
          <li><a href={link.url}>{name} on {link.name}</a></li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .council-answer { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  @media (min-width: 960px) { .council-answer { grid-template-columns: minmax(0, 2fr) minmax(15rem, 1fr); } }
  #council-tax { max-width: 48rem; margin-top: 1rem; }
  .notes { font-size: 0.9rem; color: var(--text-muted); padding-left: 1.1rem; }
  .sister-links { padding-left: 1.1rem; }
  .band-links { margin-top: 1.5rem; }
  .small-heading { font-size: 1rem; margin: 0 0 0.5rem; }
  .sister-links li { margin: 0.25rem 0; }
</style>
