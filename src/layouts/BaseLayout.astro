---
import "../styles/global.css";
// Load the first-screen faces before paint to avoid citation and fact rewrapping.
import serif600 from "@fontsource/source-serif-4/files/source-serif-4-latin-600-normal.woff2?url";
import sans400 from "@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url";
import sans600 from "@fontsource/source-sans-3/files/source-sans-3-latin-600-normal.woff2?url";
import { pageTypeFor } from "../lib/page-type";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  BEACON_SCRIPT,
  CF_BEACON_TOKEN,
  DEFAULT_DESCRIPTION,
  SITE_NAME,
  SITE_URL,
  absoluteUrl,
  jsonLd,
  pageTitle,
} from "../lib/site";
import { hubCardPath } from "../lib/og";

interface Props {
  /** The page's own title. The site name is appended after a pipe. Omit on the home page. */
  title?: string;
  description?: string;
  /** Path of this page, for the canonical tag. */
  path: string;
  noindex?: boolean;
  /** Extra JSON-LD nodes for this page. They name no person. */
  structuredData?: object[];
  /** The share card path. Defaults to the home card. */
  ogImage?: string;
  /** What the share card shows, for og:image:alt. Names no person. */
  ogImageAlt?: string;
  about?: object;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  path,
  noindex = false,
  structuredData = [],
  about,
  ogImage = hubCardPath("home"),
  ogImageAlt = `${SITE_NAME}: your council, from the official record`,
} = Astro.props;
const fullTitle = pageTitle(title);
const canonical = absoluteUrl(path);
const nodes = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: fullTitle,
    description,
    url: canonical,
    inLanguage: "en-GB",
    publisher: { "@id": `${SITE_URL}/#publisher` },
    ...(about ? { about } : {}),
    isPartOf: { "@id": `${SITE_URL}/#website` },
  },
  ...(path === "/"
    ? [
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "@id": `${SITE_URL}/#website`,
          url: SITE_URL,
          name: SITE_NAME,
          description: DEFAULT_DESCRIPTION,
          inLanguage: "en-GB",
          publisher: { "@id": `${SITE_URL}/#publisher` },
        },
      ]
    : []),
  ...structuredData,
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${SITE_URL}/#publisher`,
    name: SITE_NAME,
    url: SITE_URL,
    description: "Independent reference publisher of sourced local authority information. Not a council or government service.",
  },
];
---
<!doctype html>
<html lang="en-GB" data-pagefind-ignore={noindex ? "all" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {[serif600, sans400, sans600].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={absoluteUrl(ogImage)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <script is:inline src="/theme-init.js"></script>
    {nodes.map((node) => <script type="application/ld+json" set:html={jsonLd(node)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class="shell" data-pagefind-body data-pagefind-meta={`type:${pageTypeFor(path)}`}>
      <slot />
    </main>
    <SiteFooter />
    <script is:inline defer src={BEACON_SCRIPT} data-cf-beacon={JSON.stringify({ token: CF_BEACON_TOKEN })}></script>
  </body>
</html>
