---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { DEFAULT_DESCRIPTION, SITE_NAME, SITE_URL, absoluteUrl, jsonLd, pageTitle } from "../lib/site";

interface Props {
  /** The page's own title. The site name is appended after a pipe. Omit on the home page. */
  title?: string;
  description?: string;
  /** Path of this page, for the canonical tag. */
  path: string;
  noindex?: boolean;
  /** Extra JSON-LD nodes for this page. They name no person. */
  structuredData?: object[];
}

const { title, description = DEFAULT_DESCRIPTION, path, noindex = false, structuredData = [] } = Astro.props;
const fullTitle = pageTitle(title);
const canonical = absoluteUrl(path);
const nodes = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: fullTitle,
    description,
    url: canonical,
    inLanguage: "en-GB",
    isPartOf: { "@id": `${SITE_URL}/#website` },
  },
  ...(path === "/"
    ? [
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "@id": `${SITE_URL}/#website`,
          url: SITE_URL,
          name: SITE_NAME,
          description: DEFAULT_DESCRIPTION,
          inLanguage: "en-GB",
        },
      ]
    : []),
  ...structuredData,
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <script is:inline src="/theme-init.js"></script>
    {nodes.map((node) => <script type="application/ld+json" set:html={jsonLd(node)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class="shell" data-pagefind-body>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
