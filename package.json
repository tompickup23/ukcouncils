{
  "name": "ukcouncils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/inject_csp_hashes.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:dist": "node scripts/check-dist.mjs",
    "test:e2e": "playwright test",
    "test:csp": "playwright test --config playwright.csp.config.ts",
    "data:council-tax": "node scripts/fetch-council-tax.mjs",
    "data:registry": "node scripts/build-registry.mjs"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "astro": "^6.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
