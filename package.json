{
  "name": "ukcouncils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/inject_csp_hashes.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:dist": "node scripts/check-dist.mjs",
    "test:e2e": "playwright test",
    "test:csp": "playwright test --config playwright.csp.config.ts",
    "data:council-tax": "node scripts/fetch-council-tax.mjs",
    "data:spending": "node scripts/fetch-spending-summaries.mjs",
    "data:registry": "node scripts/build-registry.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.5",
    "d3-geo": "^3.1.1",
    "satori": "^0.63.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.6",
    "pagefind": "^1.5.2",
    "sax": "1.6.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
